@page "/"
@using KG.MES.Shared.Models.Config
@using KG.MES.Shared.Models.Dto
@using KG.MES.Shared.Models.ViewModels

<OrderListView TListItem="OrderViewModel" LoadItems="LoadOrderViewModels" TCardItem="OrderViewModel" LoadItem="LoadOrderViewModel" Settings="@AppSettings">
	<HeaderActions>
		<NavLink href="/upload" class="btn btn-primary">
			<i class="bi bi-upload"></i> Загрузить XML
		</NavLink>
		@if (!string.IsNullOrEmpty(debugInfo))
		{
			<pre class="small text-muted">@debugInfo</pre>
		}
	</HeaderActions>
</OrderListView>
