@using KG.MES.Shared.Constants
@using KG.MES.Shared.Helpers
@using KG.MES.Shared.Models.Dto
<PageTitle>Статистика рабочих мест</PageTitle>

<div class="container-fluid py-4">
	<h1 class="display-6 mb-4">
		<i class="bi bi-bar-chart"></i> Статистика рабочих мест
	</h1>

	@* Таблица участков с показателями *@
	<div class="card mb-4">
		<div class="card-header">
			<h6 class="mb-0">Участки</h6>
		</div>
		<div class="card-body p-0">
			<table class="table table-sm table-hover mb-0">
				<thead>
					<tr>
						<th>Участок</th>
						<th>Окна, шт</th>
						<th>Окна, м²</th>
						<th>Щитовые, шт</th>
						<th>Щитовые, м²</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var wp in workplaces)
					{
						@*<tr class="@(wp.Id == selectedWorkplaceId ? "table-active" : "")" 
								style='@(wp.IsWorkplace ? "cursor: pointer;" : "cursor: arrow;")' 
							@onclick="async () => { if (wp.IsWorkplace) await SelectWorkplace(wp.Id); else ClearSelection(); }">*@
						<tr class="@(wp.Id == selectedWorkplaceId ? "table-active" : "")"
							style="cursor: pointer;"
							@onclick="async () => await SelectWorkplace(wp)">
							<td>
								@*<i class="bi @(wp.IsWorkplace ? "bi-gear" : "bi-flag") me-2"></i>*@
								@wp.Name
							</td>
							<td>@wp.WindowCount</td>
							<td>@wp.WindowArea.ToString("F2")</td>
							<td>@wp.PlateCount</td>
							<td>@wp.PlateArea.ToString("F2")</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	@* Статистика и история выбранного участка *@
	@if (selectedWorkplace != null)
	{
		<div class="card mt-4">
			<div class="card-header">
				<ul class="nav nav-tabs card-header-tabs">
					@if (selectedWorkplace.IsWorkplace || selectedWorkplace.Code == WorkplaceCodes.None)
					{
						<li class="nav-item">
							<button class="nav-link @(activeTab == "orders" ? "active" : "")" @onclick='() => activeTab ="orders"'>
								<i class="bi bi-list-check me-1"></i> Заказы в работе
							</button>
						</li>
					}
					@if (selectedWorkplace.Code != WorkplaceCodes.None)
					{
						<li class="nav-item">
							<button class="nav-link @(activeTab == "history" ? "active" : "")" @onclick='() => activeTab ="history"'>
								<i class="bi bi-clock-history me-1"></i> История операций
							</button>
						</li>
					}
				</ul>
			</div>
			<div class="card-body">
				@if (activeTab == "history")
				{
					@if (selectedWorkplaceId != null)// && stats != null)
					{
						<div class="card">
							<div class="card-header d-flex align-items-center">
								<h6 class="mb-0">
									История операций 
									<small class="text-muted ms-2">@dateFrom.ToString("dd.MM.yyyy") – @dateTo.ToString("dd.MM.yyyy")</small>
								</h6>
								<button class="btn btn-sm btn-link text-secondary p-0 ms-2" @onclick="() => showDateFilter = !showDateFilter">
									<i class="bi bi-calendar3"></i>
								</button>
							</div>
							
							@if (showDateFilter)
							{
								<div class="card-body bg-light border-bottom py-2">
									<div class="d-flex align-items-center gap-2">
										<label class="form-label small mb-0">С</label>
										<input type="date" class="form-control form-control-sm" style="width: auto;" @bind="dateFrom" />
										<label class="form-label small mb-0">По</label>
										<input type="date" class="form-control form-control-sm" style="width: auto;" @bind="dateTo" />
										<button class="btn btn-sm btn-primary" @onclick="ApplyFilter">Применить</button>
									</div>
								</div>
							}
							<div class="card-body p-0">
								@if (history.Any())
								{
									<div class="table-responsive">
										<table class="table table-sm mb-0">
											<thead>
												<tr>
													<th>Тип</th>
													<th>Заказ</th>
													<th>Сотрудник</th>
													<th>Время</th>
													<th>Примечание</th>
													<th>Окна, шт</th>
													<th>Окна, м²</th>
													<th>Щитовые, шт</th>
													<th>Щитовые, м²</th>
												</tr>
											</thead>
											<tbody>
												@foreach (var h in history)
												{
													<tr>
														<td>
															<span class="badge @BadgeHelper.GetBadgeClass(h.OperationType.ToString())">
																@h.OperationType
															</span>
														</td>
														<td>@h.OrderNumber</td>
														<td>@h.UserName</td>
														<td>@h.OperationTime.ToString("dd.MM HH:mm")</td>
														<td>@h.Notes</td>
														<td>@h.WindowCount</td>
														<td>@h.WindowArea?.ToString("F2")</td>
														<td>@h.PlateCount</td>
														<td>@h.PlateArea?.ToString("F2")</td>
													</tr>
												}
											</tbody>
											<tfoot class="table-light fw-bold">
												<tr>
													<td>Итого:</td>
													<td>заказов:@history.Select(h => h.OrderNumber).Distinct().Count()</td>
													<td/>
													<td/>
													<td/>
													<td>@history.Sum(h => h.WindowCount)</td>
													<td>@history.Sum(h => h.WindowArea ?? 0).ToString("F2")</td>
													<td>@history.Sum(h => h.PlateCount)</td>
													<td>@history.Sum(h => h.PlateArea ?? 0).ToString("F2")</td>
												</tr>
											</tfoot>
										</table>
									</div>
								}
								else
								{
									<p class="text-muted small p-3">Нет операций</p>
								}
							</div>
						</div>
					}
					else
					{
						<div class="text-center py-5 text-muted">
							<i class="bi bi-arrow-down display-4"></i>
							<p>Выберите участок для просмотра статистики</p>
						</div>
					}
				}
				else if (activeTab == "orders")
				{
					var filteredOrders = orderFilter == "all" 
						? workplaceOrders.OrderBy(w => w.ReadyDate).ToList()
						: workplaceOrders.Where(o => o.Status.ToLower() == orderFilter)
							.OrderBy(w => w.ReadyDate).ToList();

					<div>
						<DynamicTable TListItem="OrderWorkplaceDto" Items="filteredOrders" ShowActions="true">
							<RowActions>
								<div class="d-flex me-auto gap-2">
									<button class="btn btn-sm @(orderFilter == "all" ? "btn-dark" : "btn-outline-dark")"
										@onclick='() => orderFilter = "all"'>
										Все
									</button>
									<button
										class="btn btn-sm @(orderFilter == "pending" ? "btn-warning" : "btn-outline-warning")"
										@onclick='() => orderFilter = "pending"'>
										Ожидают
									</button>
									<button
										class="btn btn-sm @(orderFilter == "active" ? "btn-primary" : "btn-outline-primary")"
										@onclick='() => orderFilter = "active"'>
										В работе
									</button>

									<span class="text-muted small align-self-center">
										@orderDateFrom.ToString("dd.MM") – @orderDateTo.ToString("dd.MM")
									</span>
									<button class="btn btn-sm btn-link text-secondary p-0 align-self-center"
										@onclick="() => showOrderDateFilter = !showOrderDateFilter">
										<i class="bi bi-calendar3"></i>
									</button>
								</div>
								@if (showOrderDateFilter)
								{
									<div class="card bg-light mb-3">
										<div class="card-body py-2">
											<div class="d-flex align-items-center gap-2">
												<label class="form-label small mb-0">С</label>
												<input type="date" class="form-control form-control-sm" style="width: auto;"
													@bind="orderDateFrom" />
												<label class="form-label small mb-0">По</label>
												<input type="date" class="form-control form-control-sm" style="width: auto;"
													@bind="orderDateTo" />
												<button class="btn btn-sm btn-primary"
													@onclick="() => showOrderDateFilter = false">Применить</button>
											</div>
										</div>
									</div>
								}
							</RowActions>
						</DynamicTable>


						<div class="d-flex justify-content-end mt-2">
							<span class="fw-bold me-3">Окна: @TotalWindows шт / @TotalWindowArea.ToString("F2") м²</span>
							<span class="fw-bold">Щитовые: @TotalPlates шт / @TotalPlateArea.ToString("F2") м²</span>
						</div>
					</div>
				}
			</div>
		</div>
	}
</div>